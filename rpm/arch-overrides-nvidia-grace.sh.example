# Per-arch RPM version overrides for NVIDIA Grace (aarch64)
#
# Source this file via ARCH_OVERRIDES or copy the variable exports into
# your CI environment.
#
# Usage:
#   make ARCH_OVERRIDES=rpm/arch-overrides-nvidia-grace.sh.example \
#        CUSTOM_REPO=rpm/nvidia-repo.yaml.example \
#        SINGLE_ARCH=aarch64 \
#        rpm-deps

# libvirt build with NVIDIA Grace hardware-enablement patches
LIBVIRT_VERSION_AARCH64="0:11.9.0+nvidia4-1.el9"

# QEMU layout: "bundle" uses a single consolidated qemu-kvm package
# instead of the split qemu-kvm-core / qemu-kvm-device-* subpackages.
QEMU_LAYOUT_AARCH64="bundle"
QEMU_BUNDLE_VERSION_AARCH64="0:10.1.0+nvidia1egmfix-1.el9"
